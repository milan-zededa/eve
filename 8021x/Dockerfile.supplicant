# =========================
# Stage 1: Build SCEP client
# =========================
FROM golang:1.23 AS scep-builder

# Set working directory
WORKDIR /build

# Copy the entire scep-client source tree
COPY scep-client/ ./scep-client/

# Build the binary
WORKDIR /build/scep-client

# Ensure vendor mode is used (since vendor/ exists)
ENV GOFLAGS="-mod=vendor"

# Build static-ish binary (no CGO needed here)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -o scep-client

# =========================
# Stage 2: Final runtime image
# =========================
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    wpasupplicant \
    isc-dhcp-client \
    iproute2 \
    iputils-ping \
    curl \
    unzip \
    tcpdump \
    net-tools \
    strace \
    && rm -rf /var/lib/apt/lists/*

# Create directories for certs
RUN mkdir -p /etc/ssl/certs /etc/ssl/private

# Copy config
COPY config/wpa_supplicant.conf /etc/wpa_supplicant/wpa_supplicant.conf

# Certificates
COPY certs /etc/certs
RUN chmod 600 /etc/certs/*.key

# Script for running the supplicant
COPY scripts/run-supplicant.sh /usr/local/bin/run-supplicant.sh
RUN chmod +x /usr/local/bin/run-supplicant.sh
COPY scripts/rerun-supplicant.sh /usr/local/bin/rerun-supplicant.sh
RUN chmod +x /usr/local/bin/rerun-supplicant.sh
COPY scripts/wpa-event.sh /usr/local/bin/wpa-event.sh
RUN chmod +x /usr/local/bin/wpa-event.sh

# Install SCEP client
COPY --from=scep-builder /build/scep-client/scep-client /usr/local/bin/scep-client
RUN chmod +x /usr/local/bin/scep-client

# Script for running the SCEP client
COPY scripts/run-scep-client.sh /usr/local/bin/run-scep-client.sh
RUN chmod +x /usr/local/bin/run-scep-client.sh

CMD ["/bin/bash"]